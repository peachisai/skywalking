gen_ai_call_cpm = from(GenAIModelAccess.*).cpm();

gen_ai_latency_avg = from(GenAIModelAccess.latency).longAvg();
gen_ai_latency_percentile = from(GenAIModelAccess.latency).percentile(10);

gen_ai_ttft_avg = from(GenAIModelAccess.timeToFirstToken).longAvg();
gen_ai_ttft_percentile = from(GenAIModelAccess.timeToFirstToken).percentile(10);

gen_ai_input_tokens_sum = from(GenAIModelAccess.inputTokens).sum();
gen_ai_output_tokens_sum = from(GenAIModelAccess.outputTokens).sum();

gen_ai_total_cost = from(GenAIModelAccess.totalCost).sum();